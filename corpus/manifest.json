{
	"version": 1,
	"cases": [
		{
			"id": "web-iana-reserved",
			"category": "static-web",
			"tool": "webpage-to-markdown",
			"args": {
				"url": "https://www.iana.org/domains/reserved"
			},
			"expectByProfile": {
				"full": {
					"kind": "ok",
					"contains": ["IANA"]
				},
				"slim-pdf": {
					"kind": "ok",
					"contains": ["IANA"]
				}
			}
		},
		{
			"id": "web-wikipedia-markdown",
			"category": "static-web",
			"tool": "webpage-to-markdown",
			"args": {
				"url": "https://en.wikipedia.org/wiki/Markdown"
			},
			"expectByProfile": {
				"full": {
					"kind": "ok",
					"contains": ["Markdown"]
				},
				"slim-pdf": {
					"kind": "ok",
					"contains": ["Markdown"]
				}
			},
			"blockedPatterns": ["429", "Too Many Requests", "Access Denied"]
		},
		{
			"id": "web-redirect-wikipedia",
			"category": "static-web",
			"tool": "webpage-to-markdown",
			"args": {
				"url": "https://wikipedia.org/wiki/Markdown"
			},
			"expectByProfile": {
				"full": {
					"kind": "ok",
					"contains": ["Markdown"]
				},
				"slim-pdf": {
					"kind": "ok",
					"contains": ["Markdown"]
				}
			},
			"blockedPatterns": ["429", "Too Many Requests", "Access Denied"]
		},
		{
			"id": "web-http-404",
			"category": "static-web",
			"tool": "webpage-to-markdown",
			"args": {
				"url": "https://www.w3.org/markdownify-nonexistent-404-check"
			},
			"expectByProfile": {
				"full": {
					"kind": "error",
					"contains": ["HTTP 404"]
				},
				"slim-pdf": {
					"kind": "error",
					"contains": ["HTTP 404"]
				}
			}
		},
		{
			"id": "web-ssrf-loopback",
			"category": "static-web",
			"tool": "webpage-to-markdown",
			"args": {
				"url": "http://127.0.0.1/secret"
			},
			"expectByProfile": {
				"full": {
					"kind": "error",
					"contains": ["potentially dangerous"]
				},
				"slim-pdf": {
					"kind": "error",
					"contains": ["potentially dangerous"]
				}
			}
		},
		{
			"id": "spa-js-shell",
			"category": "spa-html",
			"tool": "webpage-to-markdown",
			"args": {
				"url": "https://react.dev"
			},
			"expectByProfile": {
				"full": {
					"kind": "ok",
					"contains": ["React"],
					"notContains": ["<!DOCTYPE html>"]
				},
				"slim-pdf": {
					"kind": "ok",
					"contains": ["React"],
					"notContains": ["<!DOCTYPE html>"]
				}
			},
			"blockedPatterns": [
				"429",
				"Too Many Requests",
				"Access Denied",
				"Cloudflare"
			]
		},
		{
			"id": "spa-raw-html-rejected",
			"category": "spa-html",
			"tool": "webpage-to-markdown",
			"args": {
				"url": "https://raw.githubusercontent.com/microsoft/markitdown/main/packages/markitdown/tests/test_files/test_blog.html"
			},
			"expectByProfile": {
				"full": {
					"kind": "error",
					"contains": ["raw HTML that could not be converted to Markdown"]
				},
				"slim-pdf": {
					"kind": "error",
					"contains": ["raw HTML that could not be converted to Markdown"]
				}
			},
			"blockedPatterns": ["429", "Too Many Requests"]
		},
		{
			"id": "hosted-pdf",
			"category": "hosted-binary",
			"tool": "webpage-to-markdown",
			"args": {
				"url": "https://www.w3.org/WAI/ER/tests/xhtml/testfiles/resources/pdf/dummy.pdf"
			},
			"expectByProfile": {
				"full": {
