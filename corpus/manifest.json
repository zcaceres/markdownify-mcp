						"markitdown[all]",
						"rather than the slim Docker pdf profile"
					]
				}
			},
			"blockedPatterns": ["429", "Too Many Requests"]
		},
		{
			"id": "youtube-watch",
			"category": "youtube-bing",
			"tool": "youtube-to-markdown",
			"args": {
				"url": "https://www.youtube.com/watch?v=jNQXAC9IVRw"
			},
			"timeoutMs": 60000,
			"expectByProfile": {
				"full": {
					"kind": "ok",
					"contains": ["zoo"]
				},
				"slim-pdf": {
					"kind": "ok",
					"contains": ["zoo"]
				}
			},
			"blockedPatterns": [
				"not a bot",
				"429",
				"Too Many Requests",
				"Sign in",
				"captcha",
				"RequestBlocked",
				"IpBlocked",
				"Could not retrieve a transcript",
				"MissingDependencyException"
			]
		},
