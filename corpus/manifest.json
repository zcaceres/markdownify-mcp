				"slim-pdf": {
					"kind": "ok",
					"contains": ["Dummy PDF file"]
				}
			}
		},
		{
			"id": "hosted-docx",
			"category": "hosted-binary",
			"tool": "webpage-to-markdown",
			"args": {
				"url": "https://raw.githubusercontent.com/microsoft/markitdown/main/packages/markitdown/tests/test_files/test.docx"
