		{
			"id": "bing-search-markdown",
			"category": "youtube-bing",
			"tool": "bing-search-to-markdown",
			"args": {
				"url": "https://www.bing.com/search?q=markdown"
			},
			"timeoutMs": 45000,
			"expectByProfile": {
				"full": {
					"kind": "ok",
					"contains": ["Markdown"]
				},
				"slim-pdf": {
					"kind": "ok",
					"contains": ["Markdown"]
				}
			},
			"blockedPatterns": [
				"captcha",
				"429",
				"Too Many Requests",
				"unusual traffic",
				"bot",
				"raw HTML",
				"solve the challenge"
			]
		},
		{
			"id": "git-shorthand-octocat",
			"category": "git-repo",
			"tool": "git-repo-to-markdown",
			"args": {
				"url": "octocat/Hello-World"
			},
			"timeoutMs": 90000,
			"expectByProfile": {
				"full": {
					"kind": "ok",
					"contains": ["Hello World!"]
				},
				"slim-pdf": {
					"kind": "ok",
					"contains": ["Hello World!"]
				}
			},
			"blockedPatterns": ["rate limit", "429"]
		},
		{
			"id": "git-url-branch-compress",
			"category": "git-repo",
			"tool": "git-repo-to-markdown",
			"args": {
				"url": "https://github.com/octocat/Hello-World",
				"branch": "master",
				"compress": true
			},
			"timeoutMs": 90000,
			"expectByProfile": {
				"full": {
					"kind": "ok",
					"contains": ["README"]
				},
				"slim-pdf": {
					"kind": "ok",
					"contains": ["README"]
				}
			},
			"blockedPatterns": ["rate limit", "429"]
		},
