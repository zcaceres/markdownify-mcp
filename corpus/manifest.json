			"id": "git-creds-rejected",
			"category": "git-repo",
			"tool": "git-repo-to-markdown",
			"args": {
				"url": "https://token@github.com/owner/repo"
			},
			"expectByProfile": {
				"full": {
					"kind": "error",
					"contains": ["embedded credentials"]
				},
				"slim-pdf": {
					"kind": "error",
					"contains": ["embedded credentials"]
				}
			}
		},
